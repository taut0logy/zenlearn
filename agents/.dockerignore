# =============================================================================
# Docker Ignore - Exclude files from Docker build context
# =============================================================================

# Git
.git
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.env
.venv/
venv/
ENV/
env/
*.egg-info/
.eggs/
dist/
build/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Documentation
docs/
*.md
!README.md

# Logs (local logs shouldn't be copied)
logs/
*.log

# Docker
Dockerfile*
docker-compose*.yml
.docker/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Misc
.DS_Store
Thumbs.db
*.bak
*.tmp
